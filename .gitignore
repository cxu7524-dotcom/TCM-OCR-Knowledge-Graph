# ============================================================
# 赛题二 · 中医古籍 OCR 与知识图谱问答原型
# 原则：源码、契约、示例数据、文档进仓库；运行产物与任何凭据不进仓库。
# ============================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- 运行产物：本地库、上传件、评测报告 ----------
data/store/*.sqlite3
data/store/*.sqlite3-*
data/store/pages/*.json
data/store/graph.json
data/uploads/*
!data/uploads/.gitkeep
data/reports/*
!data/reports/.gitkeep
*.log
*.db
*.db-journal

# ---------- 本地凭据与私有配置：绝对不要提交 ----------
secrets.local.json
.env
.env.*
*.key
本地密钥*
模型权重/
*.onnx
*.bin
*.safetensors

# ---------- 样本合规：真实扫描页与人工标注不进仓库 ----------
data/samples/*.png
data/samples/*.jpg
data/samples/*.jpeg
data/samples/*.tif
data/samples/*.pdf
data/annotation/*.jsonl
data/annotation/*.json
!data/annotation/README.md

# ---------- 备份与编辑器 ----------
*.bak
备份-*/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
